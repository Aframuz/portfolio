---
// Conmutador de tema (claro / oscuro). El tema inicial ya está puesto en <html>
// por el boot script de Layout.astro; este botón solo lo cambia al pulsar.
---

<button class="theme-toggle" type="button" aria-label="Cambiar tema" data-theme-toggle>
	<span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"></path>
		</svg>
	</span>
	<span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="4.2"></circle>
			<path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"></path>
		</svg>
	</span>
</button>

<script>
	const KEY = "portafolio:tema";
	const root = document.documentElement;
	const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

	if (button) {
		button.addEventListener("click", () => {
			const next = root.dataset.theme === "dark" ? "light" : "dark";
			root.dataset.theme = next;
			try {
				localStorage.setItem(KEY, next);
			} catch {
				/* modo privado: el cambio vale para esta visita */
			}
		});
	}
</script>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 1px solid var(--ink);
		background-color: transparent;
		color: var(--ink);
		cursor: pointer;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.theme-toggle:hover {
		background-color: var(--ink);
		color: var(--paper);
	}

	.theme-toggle:has(:focus-visible) {
		outline: 2px solid var(--oxide);
		outline-offset: 2px;
	}

	.theme-toggle__icon {
		display: inline-flex;
		line-height: 0;
	}

	/* Luna en tema claro (pulsar -> oscuro); sol en tema oscuro (pulsar -> claro) */
	.theme-toggle__icon--sun {
		display: none;
	}

	html[data-theme="dark"] .theme-toggle__icon--moon {
		display: none;
	}

	html[data-theme="dark"] .theme-toggle__icon--sun {
		display: inline-flex;
	}

	@media (max-width: 760px) {
		.theme-toggle {
			width: 44px;
			height: 44px;
		}
	}
</style>
